# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test, lint and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.benchmarks/
.deepeval/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/

# Node
node_modules/
.next/
*.log

# Environment files. Real credentials never belong in the tree;
# .env.example is the tracked template, so it is re-included.
.env
.env.*
!.env.example

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local agent/tool state
.claude/settings.local.json
gitleaks.sarif

# Namespace-auth material. The official `mcp-publisher login dns` flow writes
# key.pem into the CURRENT directory by default, and that key is the sole proof
# of ownership for the whole ai.decimal/* namespace — anyone holding it can
# publish an MCP server under this brand, which runs on other people's machines.
# The real key lives outside any checkout (~/.secrets/mcp/, chmod 600); these
# rules exist so that a default-path invocation from inside the repo cannot be
# committed by accident.
*.pem
*.key
.mcp_publisher_token
